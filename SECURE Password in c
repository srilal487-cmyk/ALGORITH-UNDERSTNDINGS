//A SECURE PASSWORD ENTRY CODE IN C;
#include <stdio.h>
#include <conio.h>
#ifdef _WIN32
 #include <windows.h>
 #define sleeps(s) Sleep((s)*1000)
#else 
 #include <unistd.h>
 #define sleeps(s) sleep(s)
#endif
int main(){
    puts("PASS WORD ENTER");
    printf("ENTER YOUR PASS WORD(PRESS SPACE TO SEE):");
 
    char ch,pass[20];
    int i=0,id;
    while(1){
        ch=getch();
        if(ch=='\r'){
            break;
        } 
        else if (ch == 32) { 
            if (i > 0) {
                pass[i] = '\0'; 
                
                
                for (int k = 0; k < i; k++) printf("\b");
                
                
                printf("%s", pass);
                fflush(stdout);
                ch=getch();
                if (ch == 32){ //press again to close.
                
                
                 for (int k = 0; k < i; k++) printf("\b");
                 for (int k = 0; k < i; k++) printf("*");
                 fflush(stdout);
                }
            }

        }
        else if(ch=='\b'){
            if(i==0){
             continue;
            }
            i--;
            printf("\b \b");
            id=i;
        }
        else{
           pass[i]=ch;
           printf("%c",ch); 
           sleeps(0.3);

           printf("\b*");
           i++;
        }


    }
    pass[i]='\0';
    putchar('\n');
    printf("THE PASS WORD IS :%s\n",pass);
    printf("ENTER ANY KEY TO QUIT....");
    getch();
}
